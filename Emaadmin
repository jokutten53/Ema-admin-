<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ema Shop - Admin Dashboard</title>
    <style>
        :root { --primary: #ff4757; --bg: #f1f2f6; --text: #2f3542; }
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background: var(--bg); color: var(--text); }
        
        #loginScreen { display: flex; justify-content: center; align-items: center; height: 100vh; }
        .login-box { background: white; padding: 2.5rem; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); width: 100%; max-width: 320px; text-align: center; }
        .login-box h2 { color: var(--primary); margin-top: 0; }
        .login-box input { width: 100%; padding: 12px; margin-bottom: 15px; border-radius: 6px; border: 1px solid #dfe4ea; box-sizing: border-box; font-size: 1rem; }
        .login-box button { width: 100%; padding: 12px; background: var(--primary); color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 1rem; }
        
        #dashboardScreen { display: none; padding: 20px; max-width: 1200px; margin: 0 auto; }
        header { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; }
        header h1 { margin: 0; font-size: 1.5rem; color: var(--primary); }

        .dashboard-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 20px; }
        @media (max-width: 900px) { .dashboard-grid { grid-template-columns: 1fr; } }

        .panel { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 20px; }
        .panel h3 { margin-top: 0; border-bottom: 2px solid var(--bg); padding-bottom: 10px; }
        
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-weight: bold; margin-bottom: 5px; font-size: 0.9rem; }
        .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 10px; border: 1px solid #dfe4ea; border-radius: 6px; box-sizing: border-box; font-family: inherit; }
        
        .multi-preview-box { display: flex; gap: 10px; margin-top: 10px; overflow-x: auto; padding-bottom: 5px; }
        .multi-preview-box img { width: 60px; height: 60px; object-fit: cover; border-radius: 6px; border: 1px solid #ced6e0; }

        .btn-upload { width: 100%; padding: 12px; background: #2ed573; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }

        .filter-bar { display: flex; gap: 10px; align-items: center; margin-bottom: 15px; flex-wrap: wrap; background: #f8f9fa; padding: 12px; border-radius: 8px; border: 1px solid #dfe4ea; }
        .f-btn { padding: 8px 12px; border: 1px solid #ced6e0; background: white; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: bold; color: var(--text); transition: 0.2s; }
        .f-btn.active { background: var(--primary); color: white; border-color: var(--primary); }
        .date-input { padding: 8px; border: 1px solid #ced6e0; border-radius: 6px; font-family: inherit; font-size: 0.85rem; outline: none; }
        .btn-report { background: #2f3542; color: white; margin-left: auto; border: none; padding: 8px 15px; border-radius: 6px; font-weight: bold; cursor: pointer; }

        .order-card { border: 1px solid #dfe4ea; border-left: 5px solid var(--primary); border-radius: 8px; padding: 15px; margin-bottom: 15px; background: #fafafa; }
        .order-card.delivered { border-left-color: #a4b0be; opacity: 0.9; }
        .order-header { display: flex; justify-content: space-between; font-weight: bold; margin-bottom: 10px; font-size: 1.1rem; }
        .order-details p { margin: 5px 0; font-size: 0.95rem; }
        .order-items { background: #fff; padding: 10px; border-radius: 6px; border: 1px solid #eee; margin: 10px 0; font-size: 0.9rem; color: #555; }
        
        .order-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 15px; flex-wrap: wrap; align-items: center; }
        .btn-action { padding: 8px 15px; border-radius: 4px; font-weight: bold; cursor: pointer; border: none; font-size: 0.85rem; }
        .btn-paid { background: #0984e3; color: white; }
        .btn-complete { background: #2ed573; color: white; }
        .btn-print { background: #a4b0be; color: white; }
        .btn-delete-perm { background: #ff4757; color: white; }

        #productList { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 15px; }
        .product-card { border: 1px solid #dfe4ea; border-radius: 8px; overflow: hidden; position: relative; background: white; }
        .product-card img { width: 100%; height: 140px; object-fit: cover; }
        .product-info { padding: 12px; }
        
        .btn-delete { position: absolute; top: 5px; right: 5px; background: var(--primary); color: white; border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer; font-weight: bold; z-index: 5; font-size: 0.8rem; }
        .btn-edit { position: absolute; top: 5px; right: 38px; background: #0984e3; color: white; border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer; font-weight: bold; z-index: 5; font-size: 0.8rem; }

        #editModalOverlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100dvh; background: rgba(0,0,0,0.6); z-index: 2000; }
        #editModal { display: none; position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 25px; border-radius: 12px; z-index: 2001; width: 90%; max-width: 400px; box-shadow: 0 10px 30px rgba(0,0,0,0.2); }
        #editModal h3 { margin-top: 0; color: var(--primary); border-bottom: 2px solid #f1f2f6; padding-bottom: 10px; }
    </style>
</head>
<body>

    <div id="loginScreen">
        <div class="login-box">
            <h2>Ema Beauty Parlour</h2>
            <p style="color: #747d8c; font-size: 0.9rem;">Admin Control Panel</p>
            <input type="password" id="adminPass" placeholder="Admin Password" onkeypress="if(event.key === 'Enter') window.attemptLogin()">
            <button onclick="window.attemptLogin()">Enter Dashboard</button>
            <p id="errorMsg" style="color: #ff4757; display: none; font-size: 0.85rem; margin-top: 10px;">Incorrect Password!</p>
        </div>
    </div>

    <!-- Edit Product Modal -->
    <div id="editModalOverlay" onclick="window.closeEditModal()"></div>
    <div id="editModal">
        <h3>Edit Product Details</h3>
        <input type="hidden" id="editProdId">
        <div class="form-group"><label>Product Name</label><input type="text" id="editProdName"></div>
        <div class="form-group"><label>Price (₹)</label><input type="number" id="editProdPrice"></div>
        
        <!-- NEW COLOR EDIT BOX -->
        <div class="form-group"><label>Color Variants (Optional)</label><input type="text" id="editProdColors" placeholder="e.g., Red, Blue, Black (comma separated)"></div>
        
        <div class="form-group">
            <label>Category</label>
            <select id="editProdCategory"><option>Garments</option><option>Tailoring</option><option>Beauty</option></select>
        </div>
        <div class="form-group"><label>Description</label><textarea id="editProdDesc" rows="3"></textarea></div>
        <button class="btn-upload" onclick="window.saveEdit()">Save Changes</button>
        <button onclick="window.closeEditModal()" style="margin-top:10px; width:100%; padding:10px; border:none; background:#f1f2f6; border-radius:6px; cursor:pointer; font-weight:bold;">Cancel</button>
    </div>

    <div id="dashboardScreen">
        <header>
            <h1>Ema Shop - Admin</h1>
            <button onclick="window.logout()" style="padding: 8px 15px; border-radius:6px; border:none; cursor:pointer;">Log Out</button>
        </header>

        <div class="dashboard-grid">
            <div class="panel" style="height: fit-content;">
                <h3>+ Add New Product</h3>
                
                <div class="form-group">
                    <label>Product Photos (Select up to 10)</label>
                    <input type="file" id="fileInput" accept="image/*" multiple style="background: #f8f9fa; border: 1px dashed #ced6e0; cursor: pointer; width: 100%; padding: 10px; border-radius: 6px;">
                    <div id="multiImagePreview" class="multi-preview-box"></div>
                    <p style="font-size: 0.75rem; color: #a4b0be; margin-top: 5px;">Photos are auto-compressed to save database space.</p>
                </div>
                
                <div class="form-group"><label>Product Name</label><input type="text" id="prodName" placeholder="Item name..."></div>
                <div class="form-group"><label>Price (₹)</label><input type="number" id="prodPrice" placeholder="e.g., 500"></div>
                
                <!-- NEW COLOR ADD BOX -->
                <div class="form-group">
                    <label>Color Variants (Optional)</label>
                    <input type="text" id="prodColors" placeholder="e.g., Brown/White, Blue/White, Red (comma separated)">
                    <p style="font-size: 0.75rem; color: #a4b0be; margin-top: 5px;">Type colors in the exact order you selected the photos above. Leave blank if no colors.</p>
                </div>

                <div class="form-group">
                    <label>Category</label>
                    <select id="prodCategory"><option>Garments</option><option>Tailoring</option><option>Beauty</option></select>
                </div>
                <div class="form-group"><label>Description</label><textarea id="prodDesc" rows="3" placeholder="Fabric, fit, details..."></textarea></div>
                <button class="btn-upload" onclick="window.uploadProduct()">Save to Store</button>
            </div>

            <div>
                <div class="panel">
                    <h3>🛒 Active Orders</h3>
                    <div id="ordersList"><p style="color: #747d8c;">Waiting for new orders...</p></div>
                </div>
                
                <div class="panel">
                    <h3>🗄️ Past / Delivered Orders</h3>
                    <div class="filter-bar">
                        <button class="f-btn active" id="btnFilterAll" onclick="window.setFilter('all')">All Time</button>
                        <button class="f-btn" id="btnFilterMonth" onclick="window.setFilter('month')">This Month</button>
                        <div style="display:flex; align-items:center; gap:5px; margin-left: 10px; border-left: 2px solid #dfe4ea; padding-left: 15px;">
                            <span style="font-size: 0.8rem; font-weight: bold; color: #747d8c;">Custom:</span>
                            <input type="date" id="filterStart" class="date-input">
                            <span style="color: #a4b0be;">to</span>
                            <input type="date" id="filterEnd" class="date-input">
                            <button class="f-btn" onclick="window.setFilter('custom')">Go</button>
                        </div>
                        <button class="btn-report" onclick="window.printReport()">🖨️ Print Sales Report</button>
                    </div>
                    <div id="completedOrdersList"><p style="color: #747d8c;">No past orders yet.</p></div>
                </div>

                <div class="panel">
                    <h3>📦 Live Inventory (Tap sizes to toggle stock)</h3>
                    <div id="productList"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Firebase SDK -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.9.0/firebase-app.js";
        import { getDatabase, ref, push, onChildAdded, onChildRemoved, remove, onValue, update } from "https://www.gstatic.com/firebasejs/10.9.0/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAVKJVGHmoV_h1frjD5AASa_H9BglnVwmw",
            authDomain: "familydictionary6253.firebaseapp.com",
            databaseURL: "https://familydictionary6253-default-rtdb.firebaseio.com",
            projectId: "familydictionary6253",
            storageBucket: "familydictionary6253.firebasestorage.app"
        };

        const app = initializeApp(firebaseConfig);
        const db = getDatabase(app);
        const shopDbRef = ref(db, 'ema_shop/products');
        const ordersDbRef = ref(db, 'ema_shop/orders');

        let base64ImagesArray = []; 
        let allCompletedOrders = [];
        let currentlyFilteredOrders = [];
        let currentFilterType = 'all';
        
        window.adminProductsList = {}; 
        window.allOrdersMap = {}; 

        window.attemptLogin = () => {
            const passBox = document.getElementById('adminPass');
            if (!passBox) return; 
            const pass = passBox.value.trim().toLowerCase();
            if (pass === 'ema123') {
                document.getElementById('errorMsg').style.display = 'none';
                document.getElementById('loginScreen').style.display = 'none';
                document.getElementById('dashboardScreen').style.display = 'block';
                loadInventory(); loadOrders();
            } else { document.getElementById('errorMsg').style.display = 'block'; }
        };

        window.logout = () => { location.reload(); };

        document.getElementById('fileInput').addEventListener('change', async function(e) {
            const files = Array.from(e.target.files).slice(0, 10); // Now allows up to 10 photos safely!
            if (files.length === 0) return;
            base64ImagesArray = [];
            const previewBox = document.getElementById('multiImagePreview');
            previewBox.innerHTML = '';
            
            for (let file of files) {
                let base64String = await processAndCompressImage(file);
                base64ImagesArray.push(base64String);
                let imgEl = document.createElement('img');
                imgEl.src = base64String;
                previewBox.appendChild(imgEl);
            }
        });

        function processAndCompressImage(file) {
            return new Promise((resolve) => {
                const reader = new FileReader();
                reader.onload = function(event) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        const MAX_SIZE = 500; 
                        let width = img.width; let height = img.height;
                        if (width > height) { if (width > MAX_SIZE) { height *= MAX_SIZE / width; width = MAX_SIZE; } } 
                        else { if (height > MAX_SIZE) { width *= MAX_SIZE / height; height = MAX_SIZE; } }
                        canvas.width = width; canvas.height = height;
                        canvas.getContext('2d').drawImage(img, 0, 0, width, height);
                        resolve(canvas.toDataURL('image/jpeg', 0.6));
                    };
                    img.src = event.target.result;
                };
                reader.readAsDataURL(file);
            });
        }

        window.uploadProduct = async () => {
            const name = document.getElementById('prodName').value.trim();
            const price = document.getElementById('prodPrice').value.trim();
            const desc = document.getElementById('prodDesc').value.trim(); 
            const colorsRaw = document.getElementById('prodColors').value.trim();
            
            if (!name || !price || base64ImagesArray.length === 0) return alert("Fill all required fields and upload at least one image!");
            const initialStock = { "S": true, "M": true, "L": true, "XL": true, "Free Size": true };
            
            // Convert comma separated string into a neat array
            let colorsArray = null;
            if (colorsRaw) { colorsArray = colorsRaw.split(',').map(c => c.trim()).filter(c => c); }
            
            await push(shopDbRef, { 
                name: name, price: price, category: document.getElementById('prodCategory').value, 
                description: desc, colors: colorsArray, 
                image: base64ImagesArray[0], images: base64ImagesArray, stock: initialStock, timestamp: Date.now() 
            });
            
            document.getElementById('prodName').value = ""; document.getElementById('prodPrice').value = ""; 
            document.getElementById('prodDesc').value = ""; document.getElementById('prodColors').value = "";
            document.getElementById('fileInput').value = "";
            base64ImagesArray = []; document.getElementById('multiImagePreview').innerHTML = '';
            alert("Product added successfully!");
        };

        let inventoryLoaded = false;
        function loadInventory() {
            if (inventoryLoaded) return; inventoryLoaded = true;
            onValue(shopDbRef, (snapshot) => {
                const productList = document.getElementById('productList');
                productList.innerHTML = ''; window.adminProductsList = {};
                if (!snapshot.exists()) return;
                
                snapshot.forEach((child) => {
                    const p = child.val(); const key = child.key;
                    window.adminProductsList[key] = p; 
                    const stock = p.stock || { "S": p.inStock !== false, "M": p.inStock !== false, "L": p.inStock !== false, "XL": p.inStock !== false, "Free Size": p.inStock !== false };
                    
                    let sizeButtonsHTML = `<div style="display:flex; gap:4px; flex-wrap:wrap; margin-top:8px;">`;
                    ['S', 'M', 'L', 'XL', 'Free Size'].forEach(size => {
                        const isAvail = stock[size] !== false;
                        const btnColor = isAvail ? '#2ed573' : '#ff4757';
                        const decoration = isAvail ? 'none' : 'line-through';
                        sizeButtonsHTML += `<button onclick="window.toggleSizeStock('${key}', '${size}', ${isAvail})" style="background:${btnColor}; color:white; border:none; padding:4px 6px; border-radius:4px; font-size:0.7rem; font-weight:bold; cursor:pointer; flex:1; text-decoration:${decoration}; transition:0.2s;">${size}</button>`;
                    });
                    sizeButtonsHTML += `</div>`;

                    const card = document.createElement('div'); card.className = "product-card";
                    card.innerHTML = `<button class="btn-delete" onclick="window.deleteProduct('${key}')">✖</button><button class="btn-edit" onclick="window.openEditModal('${key}')">✏️</button><img src="${p.image}"><div class="product-info"><div style="font-weight:bold; font-size:0.95rem; line-height:1.2; margin-bottom:5px;">${p.name}</div><div style="color:#2ed573; font-weight:bold;">₹${p.price}</div>${sizeButtonsHTML}</div>`;
                    productList.prepend(card);
                });
            });
        }

        window.openEditModal = (key) => {
            const p = window.adminProductsList[key];
            document.getElementById('editProdId').value = key; document.getElementById('editProdName').value = p.name;
            document.getElementById('editProdPrice').value = p.price; document.getElementById('editProdCategory').value = p.category || "General";
            document.getElementById('editProdDesc').value = p.description || "";
            document.getElementById('editProdColors').value = p.colors ? p.colors.join(', ') : "";
            document.getElementById('editModalOverlay').style.display = 'block'; document.getElementById('editModal').style.display = 'block';
        };

        window.closeEditModal = () => { document.getElementById('editModalOverlay').style.display = 'none'; document.getElementById('editModal').style.display = 'none'; };

        window.saveEdit = async () => {
            const key = document.getElementById('editProdId').value; const newName = document.getElementById('editProdName').value.trim();
            const newPrice = document.getElementById('editProdPrice').value.trim(); const newCat = document.getElementById('editProdCategory').value;
            const newDesc = document.getElementById('editProdDesc').value.trim();
            const editColorsRaw = document.getElementById('editProdColors').value.trim();
            
            let editColorsArray = null;
            if (editColorsRaw) { editColorsArray = editColorsRaw.split(',').map(c => c.trim()).filter(c => c); }

            if(!newName || !newPrice) return alert("Name and Price are required.");
            await update(ref(db, `ema_shop/products/${key}`), { name: newName, price: newPrice, category: newCat, description: newDesc, colors: editColorsArray });
            window.closeEditModal();
        };

        window.deleteProduct = async (key) => { if(confirm("Remove product completely?")) await remove(ref(db, `ema_shop/products/${key}`)); };
        window.toggleSizeStock = async (key, size, currentStatus) => { await update(ref(db, `ema_shop/products/${key}/stock`), { [size]: !currentStatus }); };

        let ordersLoaded = false;
        function loadOrders() {
            if (ordersLoaded) return; ordersLoaded = true;
            onValue(ordersDbRef, (snapshot) => {
                const activeList = document.getElementById('ordersList');
                activeList.innerHTML = ''; allCompletedOrders = []; window.allOrdersMap = {}; let activeCount = 0;

                if (snapshot.exists()) {
                    const ordersArray = [];
                    snapshot.forEach(child => { const ord = { key: child.key, ...child.val() }; ordersArray.push(ord); window.allOrdersMap[ord.key] = ord; });
                    ordersArray.sort((a, b) => b.timestamp - a.timestamp);

                    ordersArray.forEach(order => {
                        if (order.status === "Delivered") {
                            allCompletedOrders.push(order);
                        } else {
                            const orderCard = document.createElement('div'); orderCard.className = "order-card";
                            const isPendingUPI = order.paymentStatus && order.paymentStatus.includes("Pending");
                            
                            let paymentProofHtml = '';
                            if (order.paymentScreenshot) { paymentProofHtml = `<a href="${order.paymentScreenshot}" target="_blank" style="display:inline-block; margin-right:auto; color:#0984e3; font-weight:bold; text-decoration:none; background:#e2e8f0; padding:6px 10px; border-radius:6px; font-size:0.85rem;">🖼️ View Payment Proof</a>`; }

                            let actionButtons = '';
                            if (isPendingUPI) actionButtons += `<button class="btn-action btn-paid" onclick="window.markAsPaid('${order.key}')">💰 Mark Payment Received</button>`;
                            actionButtons += `<button class="btn-action btn-print" onclick="window.printAmazonInvoice('${order.key}')">🖨️ Print Label (A5)</button>`;
                            actionButtons += `<button class="btn-action btn-complete" onclick="window.markAsDelivered('${order.key}')">📦 Mark as Delivered</button>`;

                            let itemsVisualHTML = '';
                            if (order.orderItems) {
                                order.orderItems.forEach(item => {
                                    const safeImg = (item.image || "").replace(/'/g, "\\'");
                                    itemsVisualHTML += `<div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px; background: #f8f9fa; padding: 8px; border-radius: 8px; border: 1px solid #dfe4ea;"><img src="${safeImg}" style="width: 50px; height: 50px; border-radius: 6px; object-fit: cover;"><div><div style="font-weight: bold; font-size: 0.9rem; color: #2f3542;">${item.name}</div><div style="color: #2ed573; font-weight: bold; font-size: 0.85rem;">₹${item.price}</div></div></div>`;
                                });
                            } else { itemsVisualHTML = `<p>${order.items || "N/A"}</p>`; }

                            orderCard.innerHTML = `<div class="order-header"><span>ID: ${order.orderId || "N/A"}</span><span style="color: #ff4757;">₹${order.totalAmount || 0} | <span style="background: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-size: 0.8rem; color: #2f3542;">${order.paymentStatus || order.paymentMethod || "Unknown"}</span></span></div><div class="order-details"><p><strong>Customer:</strong> ${order.customerName || "Unknown"}</p><p><strong>Phone:</strong> ${order.customerPhone || "N/A"}</p><p><strong>Address:</strong> ${order.customerAddress || "N/A"}</p><div class="order-items"><div style="font-weight: bold; margin-bottom: 8px; color: #747d8c; font-size: 0.85rem; text-transform: uppercase;">Items Ordered:</div>${itemsVisualHTML}</div><p style="font-size: 0.8rem; color: #aaa;">Ordered on: ${order.date || "N/A"}</p></div><div class="order-actions">${paymentProofHtml}${actionButtons}</div>`;
                            activeList.appendChild(orderCard); activeCount++;
                        }
                    });
                }
                if (activeCount === 0) activeList.innerHTML = '<p style="color: #747d8c;">No active orders right now.</p>';
                renderFilteredCompletedOrders();
            });
        }

        window.setFilter = (type) => {
            currentFilterType = type;
            document.getElementById('btnFilterAll').classList.remove('active'); document.getElementById('btnFilterMonth').classList.remove('active');
            if(type === 'all') document.getElementById('btnFilterAll').classList.add('active'); if(type === 'month') document.getElementById('btnFilterMonth').classList.add('active');
            renderFilteredCompletedOrders();
        };

        function renderFilteredCompletedOrders() {
            const completedList = document.getElementById('completedOrdersList');
            completedList.innerHTML = '';
            const now = new Date(); const startInput = document.getElementById('filterStart').value; const endInput = document.getElementById('filterEnd').value;
            let customStart = startInput ? new Date(startInput).getTime() : 0; let customEnd = endInput ? new Date(endInput).getTime() + 86399999 : Infinity; 

            currentlyFilteredOrders = allCompletedOrders.filter(order => {
                const orderDate = new Date(order.timestamp);
                if (currentFilterType === 'all') return true;
                if (currentFilterType === 'month') return orderDate.getMonth() === now.getMonth() && orderDate.getFullYear() === now.getFullYear();
                if (currentFilterType === 'custom') return order.timestamp >= customStart && order.timestamp <= customEnd;
                return true;
            });

            if (currentlyFilteredOrders.length === 0) { completedList.innerHTML = '<p style="color: #747d8c;">No past orders found for this date range.</p>'; return; }

            currentlyFilteredOrders.forEach(order => {
                const orderCard = document.createElement('div'); orderCard.className = "order-card delivered";
                let paymentProofHtml = '';
                if (order.paymentScreenshot) { paymentProofHtml = `<a href="${order.paymentScreenshot}" target="_blank" style="display:inline-block; margin-right:auto; color:#0984e3; font-weight:bold; text-decoration:none; background:#e2e8f0; padding:6px 10px; border-radius:6px; font-size:0.85rem;">🖼️ View Payment Proof</a>`; }

